# ==============================================================================
# Public Frontend Configuration (Vite / Vercel)
# NOTE: All VITE_* variables are bundled into browser JavaScript.
# NEVER put service-role keys, LLM keys, Chroma credentials, or Neo4j secrets here.
# ==============================================================================

# Supabase Auth browser client (anon/publishable key is safe for browser use)
VITE_SUPABASE_URL=https://uhwsbovuzmwvbgrynfiy.supabase.co
VITE_SUPABASE_ANON_KEY=

# Separately hosted FastAPI backend origin (e.g., https://your-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# Private Backend / Server-Side Configuration (FastAPI / Render)
# ==============================================================================

# Supabase JWT verification (NEVER set SUPABASE_SERVICE_ROLE_KEY here unless required)
SUPABASE_URL=https://uhwsbovuzmwvbgrynfiy.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# FastAPI CORS allow-list (comma-separated exact frontend origins; never use *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-compatible service supporting /embeddings and /chat/completions
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ChromaDB: configure Chroma Cloud (API key + tenant + database) OR CHROMA_HOST
# for a persistent remote server. When both are unset, local storage is written under RESEARCHGRAPH_DATA_DIR.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=true
CHROMA_COLLECTION=researchgraph_public
RESEARCHGRAPH_DATA_DIR=./data/researchgraph

# Neo4j graph database
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional tuning and OpenAlex polite-pool contact address
MAX_PDF_BYTES=41943040
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=240
RAG_MAX_COSINE_DISTANCE=0.65
OPENALEX_MAILTO=
